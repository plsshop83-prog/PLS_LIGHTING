<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PLS LIGHTING</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:tahoma;
}

body{

background:linear-gradient(180deg,#0c6d6d,#0a5252);

min-height:100vh;

display:flex;

justify-content:center;

align-items:center;

padding:30px;

}

.card{

width:100%;
max-width:430px;

background:rgba(255,255,255,.12);

backdrop-filter:blur(18px);

border-radius:30px;

padding:30px;

box-shadow:0 0 30px rgba(0,0,0,.25);

text-align:center;

color:white;

}

.logo{

width:150px;

height:150px;

border-radius:50%;

border:5px solid #d8a824;

object-fit:cover;

margin:auto;

display:block;

}

h1{

margin-top:20px;

font-size:34px;

color:#e0b03c;

}

.subtitle{

margin-top:10px;

font-size:20px;

}

.slogan{

margin-top:10px;

color:#e0b03c;

font-weight:bold;

}

.line{

width:120px;

height:4px;

background:#d8a824;

margin:25px auto;

border-radius:20px;

}

.btn{

display:block;

width:100%;

padding:18px;

margin:15px 0;

background:rgba(255,255,255,.18);

border-radius:18px;

text-decoration:none;

color:white;

font-size:20px;

transition:.25s;

}

.btn:hover{

background:rgba(255,255,255,.30);

transform:scale(1.03);

}

.footer{

margin-top:25px;

font-size:15px;

opacity:.8;

}

</style>

</head>

<body>

<div class="card">

<img src="logo.jpg" class="logo">

<h1>PLS LIGHTING</h1>

<div class="subtitle">

Modern Lighting & Electrical Store

</div>

<div class="slogan">

Power • Light • Star

</div>

<div class="line"></div>
<a class="btn" href="#" id="catalog">📖 کاتالوگ محصولات</a>

<a class="btn" href="#" id="instagram">📷 اینستاگرام</a>

<a class="btn" href="#" id="telegram">✈️ تلگرام</a>

<a class="btn" href="#" id="whatsapp">💬 واتساپ</a>

<a class="btn" href="#" id="rubika">📱 روبیکا</a>

<a class="btn" href="#" id="eitaa">✉️ ایتا</a>

<a class="btn" href="#" id="about">🏪 درباره فروشگاه</a>

<a class="btn" href="#" id="address">📍 آدرس فروشگاه</a>

<a class="btn" href="#" id="contact">☎️ تماس با ما</a>

<div class="footer">

PLS LIGHTING © 2026

</div>

</div>

<script>

document.getElementById("telegram").href="https://t.me/PLSLighting";

document.getElementById("rubika").href="https://rubika.ir/PLS_Lighting";

document.getElementById("eitaa").href="https://eitaa.com/mse201";

document.getElementById("instagram").href="#";

document.getElementById("catalog").href="#";

document.getElementById("whatsapp").href="#";

</script>

  <!-- پنجره انتخاب شماره -->
<div id="phonePopup" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.55);justify-content:center;align-items:center;z-index:9999;">

<div style="background:#fff;padding:25px;border-radius:20px;width:90%;max-width:340px;text-align:center;">

<h2>📞 انتخاب شماره تماس</h2>

<br>

<a class="btn" href="tel:09125192368" style="color:#111;">📱 09125192368</a>

<a class="btn" href="tel:09106378208" style="color:#111;">📱 09106378208</a>

<a class="btn" href="tel:02166342875" style="color:#111;">☎️ 02166342875</a>

<br>

<button onclick="closePhonePopup()" style="padding:12px 25px;border:none;border-radius:10px;background:#d8a824;color:white;font-size:18px;">
بستن
</button>

</div>

</div>

<script>
 document.getElementById("contact").onclick=function(e){

e.preventDefault();

document.getElementById("phonePopup").style.display="flex";

}

function closePhonePopup(){

document.getElementById("phonePopup").style.display="none";

}

document.getElementById("address").onclick=function(e){

e.preventDefault();

alert("آدرس فروشگاه:\n\nتهران، لاله زار نو، بالاتر از منوچهری، پاساژ ایرانیان، طبقه همکف، پلاک 72");
} 

</script>

</body>
</html>
